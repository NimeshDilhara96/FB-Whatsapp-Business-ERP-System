# Frontend Environment Variables

# The URL of your backend API.
# For local development, this is typically http://localhost:5000/api
# For production (Vercel), this should be your Render backend URL (e.g., https://your-backend.onrender.com/api)
VITE_API_URL=http://localhost:5000/api

# Cloudflare Turnstile Site Key (Test key shown below passes all challenges on localhost)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
